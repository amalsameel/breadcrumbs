# Meta Model API key (Muse Voice Transcribe realtime + REST; optional Muse Spark fallback)
MODEL_API_KEY=
# Google Gemini API key (read automatically by genai.Client())
GEMINI_API_KEY=
# Public HTTPS base URL for phone QR codes, e.g. https://<random>.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:8000
ASR_MODEL=muse-voice-transcribe-1.0
# Event location, used for outside/fun-fact crumbs
EVENT_LOCATION=Austin, Texas (HackTX at UT Austin)
# Dev tools: X-ray "inject turn" box + mock services when keys are missing
DEV_TOOLS=true
