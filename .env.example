# Meta Model API key (Muse Voice Transcribe realtime + REST; optional Muse Spark fallback)
MODEL_API_KEY=
# Google Gemini API key (read automatically by genai.Client())
GEMINI_API_KEY=
# Anthropic Claude API key: when set, Claude (claude-opus-5-5) is the first text provider; Gemini then Muse Spark are fallbacks
ANTHROPIC_API_KEY=
# ElevenLabs API key: natural crumb voice (first TTS provider; then Gemini TTS; else the browser voice).
# Prefetched crumbs use eleven_v4 (most natural), live lines use eleven_flash_v2_5 (fastest).
# Optional: ELEVENLABS_VOICE_ID (default Sarah, EXAVITQu4vr4xnSDxMaL) and ELEVENLABS_MODEL (overrides the prefetch model)
# pytest never uses this key (the shared client is keyless under pytest) unless BREADCRUMBS_ELEVENLABS_LIVE_TESTS=1.
ELEVENLABS_API_KEY=
# Public HTTPS base URL for phone QR codes, e.g. https://<random>.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:8000
ASR_MODEL=muse-voice-transcribe-1.0
# Event location, used for outside/fun-fact crumbs
EVENT_LOCATION=Austin, Texas (HackTX at UT Austin)
# Dev tools: enables the X-ray "Dev: inject turn" box (dev turns). Mock mode depends only on which API keys are missing.
DEV_TOOLS=true
